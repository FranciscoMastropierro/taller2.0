# Copiar a .env.local. Generar secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Neon: endpoint pooled con TLS para runtime; endpoint directo para migración.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=5
# Sólo pruebas: PostgreSQL aislado, nunca base del taller.
TEST_DATABASE_URL=
